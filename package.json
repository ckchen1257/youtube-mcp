{
  "name": "youtube-private-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote HTTP MCP server for YouTube private videos and playlist access",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local:health": "node --import=tsx scripts/local-health-check.ts",
    "test:local:mcp": "node --import=tsx scripts/local-mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "googleapis": "^171.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
